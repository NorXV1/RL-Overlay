{
  "name": "rl-overlay-streamdeck",
  "private": true,
  "description": "Plugin Stream Deck de RL Overlay",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart fr.rscast.rl-overlay\"",
    "pack": "rollup -c && node scripts/pack.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.6"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tsconfig/node20": "^20.1.11",
    "@types/node": "^24.19.2",
    "rollup": "^4.68.8",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  }
}
